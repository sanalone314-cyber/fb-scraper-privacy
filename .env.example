# ===============================================
# FB SCRAPER v1.0 — Environment Configuration
# ===============================================

# Server Port
PORT=5000

# Meta / Facebook App Credentials (From developers.facebook.com)
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:5000/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v21.0

# Session & Security Keys
JWT_SECRET=super_secret_fb_scraper_jwt_key_2026_change_in_production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex or 32 chars

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/fb_scraper

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173
